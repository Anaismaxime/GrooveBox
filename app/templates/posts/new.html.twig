{% extends 'base.html.twig' %}

{% block title %}Ajouter un article{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/ckeditor5.js') }}" type="module"></script>
    <script src="{{ asset('js/ckeditor-init.js') }}" type="module"></script>
{% endblock %}

{% block body %}
    <h1 class="title-new">Ajouter un Article</h1>

    <div class="form-container">
        {{ form_start(form) }}
        {{ form_errors(form) }}

        <div class="form-group">
            {{ form_label(form.title) }}
            {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.title) }}
        </div>

        <div class="form-group">
            {{ form_label(form.content) }}
            {{ form_widget(form.content, {'attr': {'class': 'form-control ckeditor'}}) }}
            {{ form_errors(form.content) }}
        </div>

        <div class="form-group">
            {{ form_label(form.genre) }}
            {{ form_widget(form.genre, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.genre) }}
        </div>

        <div class="form-group">
            {{ form_label(form.artists) }}
            {{ form_widget(form.artists, {'attr': {'class': 'form-select', 'size': '1'}}) }}
            {{ form_errors(form.artists) }}
        </div>


        <div class="form-group">
            {{ form_label(form.coverImage) }}
            {{ form_widget(form.coverImage) }}
            {{ form_errors(form.coverImage) }}
        </div>

        <div class="form-submit">
            {{ form_widget(form.submit, {'attr': {'class': 'btn-black'}}) }}
        </div>

        {{ form_end(form) }}

        <a href="{{ path('app_posts_index') }}" class="btn-return">Retour</a>
    </div>
{% endblock %}
