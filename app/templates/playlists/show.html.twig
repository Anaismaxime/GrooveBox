{# templates/playlists/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Détails de la playlist{% endblock %}

{% block body %}
    <section class="playlist-detail">
        <h1 class="section-title">Détails de la playlist</h1>

        {# Iframe Spotify player basé sur l'ID de la playlist #}
        <div class="spotify-player">
            <iframe
                style="border-radius:12px"
                src="https://open.spotify.com/embed/playlist/{{ playlist.spotifyId }}?utm_source=generator"
                width="100%"
                height="500"
                frameborder="0"
                allowfullscreen=""
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                loading="lazy">
            </iframe>
        </div>

        {% if is_granted('ROLE_ADMIN') %}
            <div class="admin-buttons">
                <div class="admin-btn-wrapper">
                    <a href="{{ path('app_playlists_edit', {'id': playlist.id}) }}" class="btn-admin">Modifier</a>
                </div>
                <div class="admin-btn-wrapper">
                    <form method="post" action="{{ path('app_playlists_delete', {'id': playlist.id}) }}" onsubmit="return confirm('Êtes-vous sûr ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ playlist.id) }}">
                        <button class="btn-admin">Supprimer</button>
                    </form>
                </div>
            </div>

        {% endif %}




        {% if app.user %}
            {% set isFavorite = app.user.playlists|filter(p => p.id == playlist.id)|length > 0 %}
            <form action="{{ path('app_playlists_toggle_favorite', {id: playlist.id}) }}" method="post" class="favorite-form">
                <input type="hidden" name="_token" value="{{ csrf_token('toggle-favorite' ~ playlist.id) }}">
                <button type="submit"  class="btn btn-favorite">
                    {% if isFavorite %}
                        Retirer des favoris
                    {% else %}
                        Ajouter aux favoris
                    {% endif %}
                </button>
            </form>
        {% endif %}
    </section>
    <section class="comments-container">
        <h2 class="section-title">Commentaires</h2>

        {% for comment in playlist.comments %}
            <div class="comment">
                <strong>{{ comment.user.username }}</strong> :
                <p>{{ comment.content }}</p>
                <small>Posté le {{ comment.createdAt|date('d/m/Y à H:i') }}</small>
            </div>
        {% else %}
            <p>Soyez le premier à commenter !</p>
        {% endfor %}

        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
            <div class="form-section" aria-label="Formulaire d’ajout de commentaire">
                {{ form_start(commentForm) }}

                <div class="form-group">
                    {{ form_label(commentForm.content, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(commentForm.content, {'attr': {'class': 'form-textarea'}}) }}
                    {{ form_errors(commentForm.content) }}
                </div>
                <div class="btn-center">
                    {{ form_row(commentForm.submit)}}
                </div>
                {{ form_end(commentForm) }}
            </div>
        {% else %}
            <p class="co"><a class="co" href="{{ path('app_login') }}">Connecte-toi</a> pour laisser un commentaire.</a></p>
        {% endif %}
    </section>

{% endblock %}
