<form method="post" action="{{ path('app_artists_delete', {'id': artist.id}) }}" onsubmit="return confirm('Voulez vous vraiment supprimer cet artiste?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ artist.id) }}">
    <button class="btn" aria-label="Supprimer l'artiste">Delete</button>
</form>
